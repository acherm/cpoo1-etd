<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.insarennes.cpoo1</groupId>
    <artifactId>tpa-test-etd</artifactId>
    <version>2026.2027</version>
    <packaging>jar</packaging>
    <name>CPOO1 — TP académique « Introduction au test logiciel » (squelette étudiant)</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>5.13.4</junit.version>
        <!-- 5.20.0 : indispensable pour mocker sur JDK 25 (5.14.x échoue). -->
        <mockito.version>5.20.0</mockito.version>
        <pitest.version>1.20.0</pitest.version>
        <pitest.junit5.version>1.2.2</pitest.junit5.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Expose le chemin du jar Mockito pour l'option -javaagent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>properties</id>
                        <goals><goal>properties</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- @{argLine} : JaCoCo pose son agent dans argLine.
                         Mockito en -javaagent : méthode recommandée depuis
                         Mockito 5 (l'auto-attachement disparaît des JDK
                         récents et casse le mock de java.util.Random). -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>

            <!-- Couverture : on MESURE (rapport HTML), on n'impose rien.
                 Le TP demande justement de discuter « 100 % suffit-il ? ».
                 Rapport : target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <!-- Ne pas instrumenter les internes de Mockito /
                                 ByteBuddy : sur JDK 25 JaCoCo 0.8.12 y émet des
                                 avertissements bruyants (sans conséquence). -->
                            <excludes>
                                <exclude>net.bytebuddy.*</exclude>
                                <exclude>org.mockito.*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -Pcouverture-stricte verify : exige 100 % lignes/branches.
             Réservé à l'encadrant·e (ou aux curieux) — pas au fil du TP. -->
        <profile>
            <id>couverture-stricte</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>1.0</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>1.0</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Bonus mutation (Q9) :
             mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
             Rapport : target/pit-reports/index.html
             Versions vérifiées le 2026-08-21 (PIT 1.20.0 + plugin JUnit5
             1.2.2 : les versions plus anciennes échouent avec JUnit 5.13). -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <configuration>
                            <targetClasses>
                                <param>point.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>point.*</param>
                            </targetTests>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                            </outputFormats>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
